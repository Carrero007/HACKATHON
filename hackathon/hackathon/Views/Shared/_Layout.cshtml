<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Eventos Acadêmicos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Evento" asp-action="Index">
                <span class="brand-mark">EA</span> Eventos Acadêmicos
            </a>
            <nav class="menu">
                <a asp-controller="Evento" asp-action="Index">Eventos</a>

                @if (User.Identity!.IsAuthenticated)
                {
                    if (User.IsInRole("ALUNO"))
                    {
                        <a asp-controller="Inscricao" asp-action="MinhasInscricoes">Minhas inscrições</a>
                    }
                    if (User.IsInRole("CRIADOR"))
                    {
                        <a asp-controller="Evento" asp-action="MeusEventos">Meus eventos</a>
                        <a asp-controller="Evento" asp-action="Criar">Criar evento</a>
                    }
                    <span class="user-tag">Olá, @User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        <button type="submit" class="link-btn">Sair</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Login</a>
                    <a class="cta-ghost" asp-controller="Account" asp-action="Cadastro">Criar conta</a>
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        &copy; @DateTime.Now.Year — Eventos Acadêmicos. Todos os direitos reservados.
    </footer>
</body>
</html>
