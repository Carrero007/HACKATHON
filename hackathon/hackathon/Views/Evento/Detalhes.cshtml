@model hackathon.Models.Evento
<h2>@Model.Titulo</h2>
@if (TempData["Sucesso"] != null)
{
    <p style="color:green">✓ @TempData["Sucesso"]</p>
}
@if (TempData["Erro"] != null)
{
    <p style="color:red">@TempData["Erro"]</p>
}
<p>@Model.Descricao</p>
<p>Data: @Model.DataHora.ToString("dd/MM/yyyy HH:mm")</p>
<p>Local: @Model.Local</p>
<p>Criador: @Model.CriadorNome</p>

@if (User.IsInRole("ALUNO"))
{
    if (Model.JaInscrito)
    {
        <p>✓ INSCRITO</p>
    }
    else
    {
        <form asp-controller="Inscricao" asp-action="Participar" method="post">
            <input type="hidden" name="eventoId" value="@Model.Id" />
            <button type="submit">PARTICIPAR</button>
        </form>
    }
}

@if (User.Identity!.IsAuthenticated && User.FindFirst("UsuarioId")!.Value == Model.CriadorId.ToString())
{
    <a asp-action="Editar" asp-route-id="@Model.Id">EDITAR</a>
    <form asp-action="Excluir" asp-route-id="@Model.Id" method="post" style="display:inline">
        <button type="submit">EXCLUIR</button>
    </form>

    <hr />
    <h3>QR CODE DE PRESENÇA</h3>
    <div id="qrcode"></div>
    <p>Escaneie este código para confirmar sua presença.</p>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrcode"), {
            text: window.location.origin + "/Presenca/Confirmar?eventoId=@Model.Id",
            width: 180,
            height: 180
        });
    </script>
}

<hr />
<h3>Comentários</h3>
@foreach (var c in (List<hackathon.Models.Comentario>)ViewBag.Comentarios)
{
    <p><strong>@c.UsuarioNome:</strong> @c.Texto</p>
}

@if (User.Identity!.IsAuthenticated)
{
    <form asp-controller="Comentario" asp-action="Criar" method="post">
        <input type="hidden" name="eventoId" value="@Model.Id" />
        <textarea name="texto" placeholder="Escreva um comentário"></textarea>
        <button type="submit">COMENTAR</button>
    </form>
}